#!/bin/bash
# H3X Pre-Install Script
# Stops existing sentinel if running, backs up any existing config

PLIST="/Library/LaunchDaemons/ai.qompute.h3x.sentinel.plist"

# Stop existing sentinel daemon if running
if launchctl list | grep -q "ai.qompute.h3x.sentinel"; then
    launchctl unload "$PLIST" 2>/dev/null || true
    echo "Stopped existing H3X sentinel."
fi

exit 0
