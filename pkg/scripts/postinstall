#!/bin/bash
# H3X Post-Install Script
# Loads the sentinel daemon and verifies installation

PLIST="/Library/LaunchDaemons/ai.qompute.h3x.sentinel.plist"

# Load the sentinel daemon (runs at boot, monitors system geometry)
if [ -f "$PLIST" ]; then
    launchctl load -w "$PLIST" 2>/dev/null || true
    echo "H3X Sentinel daemon loaded."
fi

# Verify tools are accessible
if command -v h3x_analyze &>/dev/null; then
    echo "H3X toolkit installed successfully."
    echo "  Tools: $(ls /usr/local/bin/h3x_* 2>/dev/null | wc -l | tr -d ' ') binaries"
    echo "  Run: h3x_analyze <file>"
else
    echo "H3X tools installed to /usr/local/bin/"
fi

exit 0
